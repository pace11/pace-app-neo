# Generate with:
#   docker run --rm -v "$(pwd)/waha":/app/env devlikeapro/waha init-waha /app/env
# then rename/use the generated values below.

WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# Public URL via Cloudflare Tunnel (HTTPS, no trailing slash)
WAHA_PUBLIC_URL=https://waha.yourdomain.com
WHATSAPP_API_SCHEMA=https
WHATSAPP_API_HOSTNAME=waha.yourdomain.com
WHATSAPP_API_PORT=443
